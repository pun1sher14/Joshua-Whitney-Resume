function home() { if (allMode) return; $("panel").innerHTML = "<h2>" + esc(DATA.name) + "</h2><p>" + esc(DATA.tagline) + "</p><p class='meta'>" + esc(DATA.contact) + "</p>"; }
function show(st) {
