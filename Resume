Data", JSON.stringify(DATA)); } if (!DATA.projectsV3) { DATA.projectsV3 = true; const pf = DATA.sections.find(x => x.title === "Projects"); if (pf && pf.items && pf.items[0] && pf.items[0].bullets && !pf.items[0].bullets.some(b => b.startsWith("Fractions for exact math"))) pf.items[0].bullets.push(DEFAULT_DATA.sections.find(x => x.title === "Projects").items[0].bullets.find(b => b.startsWith("Fractions for exact math"))); localStorage.setItem("resumeData", JSON.stringify(DATA)); } if (!DATA.jsAdded) { DATA.jsAdded = true; const tj = DATA.sections.find(x => x.title === "Technical Skills"); if (tj && tj.tags && !tj.tags.includes("JavaScript")) { const k = tj.tags.indexOf("C#"); tj.tags.splice(k >= 0 ? k + 1 : tj.tags.length, 0, "JavaScript"); } localStorage.setItem("resumeData", JSON.stringify(DATA)); } if (!DATA.honorsAdded) { DATA.honorsAdded = true; const te = DATA.sections.find(x => x.title === "Education"); if (te && te.items && te.items[0] && te.items[0].bullets && !te.items[0].bullets.includes("Honors Society")) { const k = te.items[0].bullets.findIndex(b => b.startsWith("Dean")); te.items[0].bullets.splice(k >= 0 ? k + 1 : 0, 0, "Honors Society"); } localStorage.setItem("resumeData", JSON.stringify(DATA)); } if (!DATA.honorsV2) { DATA.honorsV2 = true; const th = DATA.sections.find(x => x.title === "Education"); if (th && th.items && th.items[0] && th.items[0].bullets) th.items[0].bullets = th.items[0].bullets.map(b => b === "Honors Society" ? "Winthrop University Honors Association" : b); localStorage.setItem("resumeData", JSON.stringify(DATA)); } if (!DATA.projectsV4) { DATA.projectsV4 = true; const pm = DATA.sections.find(x => x.title === "Projects"); if (pm && pm.items && pm.items[0] && pm.items[0].bullets) pm.items[0].bullets = pm.items[0].bullets.map(b => b === "LED Expression Mask (in progress)" ? "LED Expression Mask (in progress): It’s a mask with face detection on an ESP32 with a camera and an LED matrix to match the user’s expressions." : b); localSt