const $ = id => document.getElementById(id);
const esc = s => String(s == null ? "" : s).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const cv = $("c"), ctx = cv.getContext("2d"), W = 800, H = 400, GY = 330;
let stations = [], solids = [], visited = new Set(), active = -1, worldW = 2000;
const me = { x: 120, y: GY - 40, vx: 0, vy: 0, w: 22, h: 40, dir: 1, ground: false, t: 0 };
