  let near = -1;
  stations.forEach((st, i) => { if (Math.abs(me.x + me.w / 2 - st.x) < 80 && Math.abs(me.y + me.h - st.base) < 110) near = i; });
  if (near !== active) { active = near; if (near >= 0) { cp = { x: stations[near].x - me.w / 2, y: stations[near].base - me.h }; visited.add(near); updateCount(); show(stations[near]); } else home(); }
  if (!won && stations.length && near === stations.length - 1) { won = true; $("winTxt").textContent = "You Win! Falls: " + falls; $("win").style.display = "block"; }
  const cam = Math.max(0, Math.min(worldW - W, me.x + me.w / 2 - W / 2));
  sky(cam);
  ctx.save(); ctx.translate(-cam, 0);
  stations.forEach((st, i) => bldg(st, i === active));
  solids.forEach((r, i) => { if (r.x + r.w < cam || r.x > cam + W) return; ctx.fillStyle = "#17102e"; ctx.fillRect(r.x, r.y, r.w, r.h); ctx.shadowColor = "#00f0ff"; ctx.shadowBlur = 10; ctx.fillStyle = "#00f0ff"; ctx.fillRect(r.x, r.y, r.w, r.h > 20 ? 4 : 3); ctx.shadowBlur = 0; if (r.h > 20) { ctx.fillStyle = "rgba(255,61,154,.55)"; ctx.fillRect(r.x, r.y + 14, r.w, 2); } });
  player(); ctx.restore();
  if (won) { ctx.fillStyle = "rgba(0,0,0,.5)"; ctx.fillRect(0, 40, W, 130); ctx.textAlign = "center"; ctx.fillStyle = "#ffd84a"; ctx.font = "bold 56px system-ui,sans-serif"; ctx.fillText("You Win!", W / 2, 105); ctx.fillStyle = "#fff"; ctx.font = "bold 26px system-ui,sans-serif"; ctx.fillText("Falls: " + falls, W / 2, 148); }
  ctx.fillStyle = "rgba(0,0,0,.55)"; ctx.fillRect(10, 10, 160, 8); ctx.fillStyle = "#ffd84a"; ctx.fillRect(10, 10, 160 * (me.x / worldW), 8);
  requestAnimationFrame(frame);
}
$("again").onclick = () => { won = false; $("again").blur(); $("win").style.display = "none"; build(); };
$("allBtn").onclick = () => {
  allMode = !allMode; $("allBtn").blur();
  $("allBtn").textContent = allMode ? "Back to game" : "Show all sections";
  if (allMode) {
    let all = "";
    (DATA.sections || []).forEach(s => { show({ s, force: 1 }); all += $("panel").innerHTML + "<hr style='border:0;border-top:1px solid var(--line);margin:18px 0'>"; });
    $("panel").innerHTML = all;
  } else if (active >= 0) show(stations[active]); else home();
};
if ($("editBtn")) $("editBtn").onclick = () => { const ed = $("ed"), open = ed.style.display === "block"; ed.style.display = open ? "none" : "block"; if (!open) $("ta").value = JSON.stringify(DATA, null, 2); };
$("apply").onclick = () => {
  try { const d = JSON.parse($("ta").value); if (!d.name || !Array.isArray(d.sections)) throw new Error("Needs a name and a sections list.");
    DATA = d; try { localStorage.setItem("resumeData", JSON.stringify(d)); } catch (e) {}
    build(); $("msg").textContent = "Applied. Run to the buildings to see your changes.";
  } catch (e) { $("msg").textContent = "Could not apply: " + e.message; }
};
$("copy").onclick = () => { $("ta").select(); try { document.execCommand("copy"); $("msg").textContent = "Copied."; } catch (e) {} };
$("reset").onclick = () => { DATA = DEFAULT_DATA; try { localStorage.removeItem("resumeData"); } catch (e) {} $("ta").value = JSON.stringify(DATA, null, 2); build(); $("msg").textContent = "Back to the original resume."; };
build(); requestAnimationFrame(frame);
</script>
</body>
