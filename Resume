function updateCount() { $("count").textContent = "Visited " + visited.size + " of " + stations.length + " · Falls: " + falls; }
const lnk = b => esc(b).replace(/([\w.+-]+@[\w-]+\.[\w.]+)/g, '<a href="mailto:$1" style="color:var(--maroon)">$1</a>').replace(/(\d{3}-\d{3}-\d{4})/g, '<a href="tel:$1" style="color:var(--maroon)">$1</a>');
